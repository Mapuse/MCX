# MCX — build.ninja (auto-detects amd64/arm64)
# Usage: ninja
#        DESTDIR=/mnt ninja install

rule cargo
  command = sh -c 'case $$(uname -m) in x86_64) T=x86_64-unknown-linux-musl;; aarch64) T=aarch64-unknown-linux-musl;; *) echo "unsupported: $$(uname -m)" >&2; exit 1;; esac; CARGO_TARGET_DIR=$$(pwd)/builddir/cargo cargo build --target $$T --release --locked --manifest-path $$(pwd)/Cargo.toml && cp $$(pwd)/builddir/cargo/$$T/release/mcx "$out"'
  description = cargo build mcx

rule install
  command = install -Dm755 $in $${DESTDIR}/system/bin/mcx
  description = install mcx

builddir = builddir

build $builddir/mcx: cargo
default $builddir/mcx

build install: install $builddir/mcx
